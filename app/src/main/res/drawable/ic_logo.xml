<?xml version="1.0" encoding="utf-8"?>
<!--
  ARGUS mark: the all-seeing eye. Almond lids, an amber iris ring with a soft warm fill,
  a dark slit pupil, a teal inner ring (the gauge heritage) and a small glint.
  108x108 viewport = adaptive-icon canvas; the eye corners sit at radius 32, inside the 66dp safe zone.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Iris: warm fill -->
    <path
        android:pathData="M42,54 a12,12 0 1,0 24,0 a12,12 0 1,0 -24,0 Z"
        android:fillColor="#40FFA43A" />

    <!-- Teal inner ring -->
    <path
        android:pathData="M46.5,54 a7.5,7.5 0 1,0 15,0 a7.5,7.5 0 1,0 -15,0 Z"
        android:strokeColor="#3CCFB8"
        android:strokeWidth="1.2"
        android:fillColor="#00000000" />

    <!-- Iris ring -->
    <path
        android:pathData="M42,54 a12,12 0 1,0 24,0 a12,12 0 1,0 -24,0 Z"
        android:strokeColor="#FFA43A"
        android:strokeWidth="3"
        android:fillColor="#00000000" />

    <!-- Slit pupil -->
    <path
        android:pathData="M54,45 C56.2,48 56.2,60 54,63 C51.8,60 51.8,48 54,45 Z"
        android:fillColor="#0B0B0C" />

    <!-- Glint -->
    <path
        android:pathData="M47.2,48 a1.8,1.8 0 1,0 3.6,0 a1.8,1.8 0 1,0 -3.6,0 Z"
        android:fillColor="#EDEDEF" />

    <!-- Lids -->
    <path
        android:pathData="M22,54 Q54,22 86,54 Q54,80 22,54 Z"
        android:strokeColor="#EDEDEF"
        android:strokeWidth="3"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />
</vector>
