<?xml version="1.0" encoding="utf-8"?>
<!--
  Window background shown by the system the instant the app launches, before any
  app code runs. The Compose intro overlay draws the same mark at the same size and
  position, then fades it out — so the hand-off is seamless.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/ingwe_background" />
    <item
        android:width="168dp"
        android:height="168dp"
        android:gravity="center"
        android:drawable="@drawable/ic_logo" />
</layer-list>
