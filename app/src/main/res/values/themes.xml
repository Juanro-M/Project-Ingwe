<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Base theme: dark, no action bar. The window background is the splash (logo on
      black), so the very first frame after tapping the icon is already branded.
      Keep-screen-on is set in MainActivity.
    -->
    <style name="Theme.Ingwe" parent="android:Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@drawable/splash_background</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
    </style>
</resources>
